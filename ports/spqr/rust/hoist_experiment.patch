+
+/// Copyable raw view of a `UVec`'s buffer. Taken once at the top of a hot method so the data pointer is a
+/// local SSA value instead of a field load that LLVM must redo after every store through it.
+/// Invariant: the source `UVec` is not resized while a `P` of it is live.
+#[derive(Clone, Copy)]
+struct P<T> {
+	p: *mut T,
+	n: usize,
+}
+impl<T> P<T> {
+	#[inline(always)]
+	fn of(v: &mut UVec<T>) -> Self {
+		P { p: v.0.as_mut_ptr(), n: v.0.len() }
+	}
+}
+impl<T> Index<usize> for P<T> {
+	type Output = T;
+	#[inline(always)]
+	fn index(&self, i: usize) -> &T {
+		debug_assert!(i < self.n);
+		unsafe { &*self.p.add(i) }
+	}
+}
+impl<T> IndexMut<usize> for P<T> {
+	#[inline(always)]
+	fn index_mut(&mut self, i: usize) -> &mut T {
+		debug_assert!(i < self.n);
+		unsafe { &mut *self.p.add(i) }
+	}
+}
