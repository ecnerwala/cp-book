+#[inline(always)]
+fn map_rot_edge<const WP: bool>(qem: P<i32>, ren: P<i32>, planar: bool, ve: i32) -> [i32; 4] {
+	if !WP {
+		return [-1, -1, -1, -1];
 	}
+	if !planar {
+		return [-1, -1, -1, -1];
+	}
+	let mut res = [0; 4];
+	for z in 0..4 {
+		let o = qem[(4 * ve) as usize + z];
+		debug_assert!(o != -1);
+		res[z] = (ren[(o >> 2) as usize] << 2) + (o & 2) + ((z & 1) == 0) as i32;
+	}
+	res
