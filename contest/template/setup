#!/usr/bin/env bash

# Flatten the Makefile: splice -include'd hook files (config.mk, local.mk)
# from layered templates into a single self-contained Makefile.
sed -i 's|^-include \(.*\)|cat \1 2>/dev/null|e' Makefile
rm -f config.mk local.mk

if root=$(git rev-parse --show-toplevel 2>/dev/null) && [ -e "$root/.autocommit" ]; then
	prefix=$(git rev-parse --show-prefix)
	git add -A . && git diff --cached --quiet -- . || git commit -q -m "[autocommit] setup ${prefix%/}" -- . || true
fi

bear -- make all
